#run the bootmina.sh, seclabel can not be delete from android M
service bootmina /system/bin/sh /system/bin/bootmina.sh
  class core
  user root
  group system
  disabled
  oneshot
  seclabel u:r:bootmina:s0

service dbus_system /system/bin/dbus-daemon --system --nofork --nopidfile --syslog-only
  class late_start
  user root
  group root
  oneshot
  disabled
  seclabel u:r:bootmina:s0

service dbus_session /system/bin/dbus-daemon --session --nofork --nopidfile --syslog-only
  class late_start
  user root
  group root
  oneshot
  disabled
  seclabel u:r:bootmina:s0

service weston /system/bin/logwrapper /syscore/bin/weston --backend=fbdev-backend.so --config=/syscore/etc/xdg/weston/weston.ini
  class late_start
  user root
  group root
  setenv LD_LIBRARY_PATH /apex/com.android.art/lib64:/apex/com.android.os.statsd/lib64:/syscore/lib:/syscore/lib/weston:/syscore/lib/android
  oneshot
  disabled
  seclabel u:r:bootmina:s0

service senserservice /system/bin/sensorservice
  class main
  user root
  group system
  seclabel u:r:bootmina:s0

service pulseaudio /syscore/bin/pulseaudio --start -vvvvv
  class main
  user root
  group system
  setenv PATH $PATH:/syscore/bin
  setenv PULSE_COOKIE /data/var/run/pulse/.config/pulse/cookie
  setenv PULSE_RUNTIME_PATH /data/var/run/pulse
  setenv PULSE_STATE_PATH /data/var/run/pulse
  setenv LD_LIBRARY_PATH /system/lib64:/syscore/lib:/syscore/lib:/syscore/lib/pulseaudio:/syscore/lib/pulse-13.0/modules/
  setenv PREFIX /syscore
  setenv NODE_PATH /syscore/lib/node_modules/
  setenv SERVICE_MAIN_PATH /syscore
  oneshot
  seclabel u:r:bootmina:s0

on property:init.svc.vendor.dataadpl=running && property:persist.sys.fuse=true
  rm /data_mirror/run
  mkdir /data_mirror/run 0700 root root
  mkdir /data_mirror/run/dbus 0750 root root
  mkdir /data_mirror/run/user 0700 root root
  mkdir /data_mirror/run/user/0 0700 root root
  export XDG_RUNTIME_DIR /data_mirror/run/user/0
  export XDG_CONFIG_HOME /syscore/etc/xdg
  export XKB_CONFIG_ROOT /syscore/share/X11/xkb
  export XCOMPOSEFILE /syscore/share/X11/locale/zh_CN/Compose
  export DBUS_SYSTEM_BUS_ADDRESS unix:path=/data_mirror/run/dbus/system_bus_socket
  export DBUS_SESSION_BUS_ADDRESS unix:path=/data_mirror/run/user/0/bus
  wait /data_mirror/run/user/0/test 10
  start syslogng
  start dbus_system
  start dbus_session
  start pulseaudio
  
